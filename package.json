{
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build",
    "start": "node --conditions=react-server --import tsx --env-file-if-exists=.env scripts/start.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:setup": "npx tsx lib/db/setup.ts",
    "db:seed": "npx tsx lib/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "media:cleanup": "node --conditions=react-server --import tsx --env-file-if-exists=.env scripts/media-cleanup.ts",
    "video:worker": "node --max-old-space-size=384 --conditions=react-server --import tsx --env-file-if-exists=.env scripts/video-worker.ts",
    "config:check": "node --import tsx --env-file-if-exists=.env scripts/check-config.ts",
    "security:prune": "node --conditions=react-server --import tsx --env-file-if-exists=.env scripts/prune-security.ts",
    "test:browser": "node scripts/browser-check.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@tailwindcss/postcss": "4.1.7",
    "@types/node": "^22.15.18",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "jose": "^6.0.11",
    "lucide-react": "^0.511.0",
    "next": "15.5.28",
    "postcss": "8.5.30",
    "postgres": "^3.4.5",
    "radix-ui": "^1.4.2",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^18.1.0",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "4.1.7",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.8.3",
    "zod": "^3.24.4"
