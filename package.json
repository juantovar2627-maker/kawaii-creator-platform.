      "tar": "7.5.22",
      "qs": "6.16.1",
      "shell-quote": "1.12.0",
      "nanoid@3": "3.3.20",
      "browserslist": "4.29.3",
      "source-map-js": "1.2.2",
      "sharp": "0.35.5",
      "postcss": "8.5.30"
    }
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "playwright": "1.64.1"
  }
