# Server-only template. Supply actual values securely; never commit filled files.
# Requires an HTTPS ingress that restricts direct backend access and overwrites
# Host, X-Forwarded-Proto and X-Mimi-Client-IP. See docs/phase-four-a.md.
APP_ENV=staging
NODE_ENV=production
BASE_URL=https://staging.example.invalid
POSTGRES_URL=
AUTH_SECRET=
SESSION_COOKIE_SECURE=true
TRUSTED_ORIGINS=https://staging.example.invalid
TRUSTED_CLIENT_IP_HEADER=x-mimi-client-ip
STAGING_ACCESS_USERNAME=tester
STAGING_ACCESS_PASSWORD=
# Operator assertion after independently verifying separate synthetic DB/bucket.
STAGING_DATA_ISOLATED=false
SIGNUP_ENABLED=false
MEDIA_UPLOADS_ENABLED=false
VIDEO_UPLOADS_ENABLED=false
VIDEO_WORKER_ENABLED=false
PAYMENTS_ENABLED=false
# Optional: independent strong token for restricted infrastructure diagnostics.
# HEALTHCHECK_TOKEN=
# Add a SEPARATE PRIVATE staging bucket and the MEDIA_S3_* variables from
# .env.example only when prepared. Never reuse production buckets/credentials.
# Do not enable uploads until scanners/isolation/retention have been verified.
