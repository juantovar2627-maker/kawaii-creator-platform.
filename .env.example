# Copy to .env and configure a development Postgres database and AUTH_SECRET.
# Use .env so database scripts can load these settings as well as Next.js.
POSTGRES_URL=postgresql://***
BASE_URL=http://localhost:3000
AUTH_SECRET=***

# Payments stay disabled unless explicitly enabled AND a Stripe key is configured.
PAYMENTS_ENABLED=false
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are optional; leave unset for development.

# Optional photo/video storage. Leave unset to disable uploads safely (text posts work).
# Local testing ONLY: BASE_URL must be loopback, root must be outside this repo.
# MEDIA_STORAGE_DRIVER=local
# MEDIA_LOCAL_ROOT=/absolute/private/path/mimi-media
# MEDIA_SCAN_MODE=development-manual
# Production: private R2/S3 bucket with no public domain, ACL, or listing.
# MEDIA_STORAGE_DRIVER=s3
# MEDIA_S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# MEDIA_S3_REGION=auto
# MEDIA_S3_BUCKET=mimi-private
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# HTTPS service implementing docs/phase-three-a.md scanner contract (required
# before production photo approval). Never add NEXT_PUBLIC_ storage variables.
# MEDIA_SCANNER_URL=
# MEDIA_SCANNER_TOKEN=

# Optional asynchronous video worker (see docs/phase-three-b.md).
# Work directory must be absolute and outside the repository, with a private volume.
# VIDEO_WORK_ROOT=/absolute/private/path/mimi-video-work
# Production default: Bubblewrap + FFmpeg/FFprobe, fails closed if unavailable.
# VIDEO_SANDBOX_MODE=bwrap
# VIDEO_FFMPEG_PATH=/usr/bin/ffmpeg
# VIDEO_FFPROBE_PATH=/usr/bin/ffprobe
# Trusted HTTPS full-frame/audio scanner; separate from the photo scanner.
# VIDEO_SCANNER_URL=
# VIDEO_SCANNER_TOKEN=
# For SYNTHETIC LOCAL fixtures only, with local storage + loopback BASE_URL:
# VIDEO_SANDBOX_MODE=development-prlimit
# MEDIA_SCAN_MODE=development-manual
